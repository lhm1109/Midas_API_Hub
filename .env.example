# Supabase Configuration
SUPABASE_URL=https://vqdtbhvoytalprawwxfe.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# User ID (for locking mechanism)
# Generate a unique ID for each developer
USER_ID=user_1

# Zendesk Configuration (Manual tab "Send")
# Example URL: https://{subdomain}.zendesk.com/hc/en-us/articles/{article_id}
ZENDESK_BASE_URL=https://midas-support.zendesk.com/api/v2/help_center
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_TOKEN=your-zendesk-api-token
# Optional fallback (used only if API token is not set)
ZENDESK_PASSWORD=
ZENDESK_DEFAULT_LOCALE=en-us
# Optional default target shown in Manual tab
ZENDESK_DEFAULT_ARTICLE_URL=
ZENDESK_DEFAULT_ARTICLE_ID=

# Optional publish defaults (used by Manual tab Send)
ZENDESK_DEFAULT_SECTION_ID=
ZENDESK_DEFAULT_PERMISSION_GROUP_ID=
ZENDESK_DEFAULT_USER_SEGMENT_ID=all
ZENDESK_DEFAULT_USER_SEGMENT_IDS=
ZENDESK_DEFAULT_AUTHOR_ID=
ZENDESK_DEFAULT_LABELS=CIVIL NX,API
ZENDESK_DEFAULT_CONTENT_TAG_IDS=
ZENDESK_DEFAULT_PROMOTED=false
ZENDESK_DEFAULT_COMMENTS_ENABLED=true
ZENDESK_DEFAULT_NOTIFY_SUBSCRIBERS=false
ZENDESK_DEFAULT_DRAFT=false
ZENDESK_DEFAULT_ATTACHMENT_IDS=
