                "component": "ComboBox",
                "groupId": "SEIS_LOAD",
                "label": "EPA (S)",
                "order": 3
              }
            },
            "SITE_CLS": {
              "type": "integer",
              "description": "Site class (T_SEPR_KISTEC_D.nSiteClass).",
