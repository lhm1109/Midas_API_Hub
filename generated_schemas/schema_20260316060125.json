            "EPA_S",
            "SITE_CLS",
            "FA",
            "FV",
            "SDS",
            "SD1",
            "IE",
            "EFF_WGT",
            "DP",
            "LAMBDA_S"
          ],
          "additionalProperties": false,
          "properties": {
            "METHOD": {
              "type": "string",
              "description": "Calculation method selector shown at the top of the dialog. This screenshot variant is KISTEC2019-specific.",
              "oneOf": [
                {
                  "title": "KISTEC2019",
                  "const": "KISTEC2019"
                }
              ],
              "x-ui": {
                "component": "ComboBox",
                "groupId": "GENERAL",
                "label": "Method",
                "order": 1
              }
            },
            "SEIS_ZON": {
              "type": "integer",
              "description": "Seismic zone (T_SEPR_KISTEC_D.nSeismicZone).",
