                },
                {
                  "title": "Virtual Beam",
                  "const": 1
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "Element Type",
                "order": 1
              }
            },
            "POSITION": {
              "type": "integer",
              "description": "Position Type",
              "default": 0,
              "oneOf": [
                {
                  "title": "I",
                  "const": 0
                },
                {
                  "title": "J",
                  "const": 1
                },
                {
                  "title": "I & J",
                  "const": 2
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "Position Type",
                "order": 2
              }
            },
            "LTM_TYPE": {
              "type": "integer",
              "description": "Load Test Measurement Type",
              "default": 0,
              "oneOf": [
                {
                  "title": "Auto Calculation",
                  "const": 0
                },
                {
                  "title": "User Input",
                  "const": 1
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "Load Test Measurement Type",
                "order": 3
              }
            },
            "STRAIN_I": {
              "type": "number",
              "description": "Strain at I-End. Required when LTM_TYPE is Auto Calculation(0) and POSITION is I(0) or I & J(2).",
              "default": 0.00001,
              "x-ui": {
                "component": "NumberInput",
                "label": "Strain(I)",
                "order": 4
              },
              "x-required-when": {
                "LTM_TYPE": 0,
                "POSITION": [
                  0,
                  2
                ]
              }
            },
            "STRAIN_J": {
              "type": "number",
              "description": "Strain at J-End. Required when LTM_TYPE is Auto Calculation(0) and POSITION is J(1) or I & J(2).",
              "default": 0.00001,
              "x-ui": {
                "component": "NumberInput",
                "label": "Strain(J)",
                "order": 5
              },
              "x-required-when": {
                "LTM_TYPE": 0,
                "POSITION": [
                  1,
                  2
                ]
              }
            },
            "KB": {
              "type": "number",
              "description": "Load Test Measurement Benefit Factor. Required when LTM_TYPE is Auto Calculation(0).",
