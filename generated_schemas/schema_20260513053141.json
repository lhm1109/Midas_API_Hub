              "x-ui": {
                "component": "NumberInput",
                "label": "Kb",
                "order": 6
              },
              "x-required-when": {
                "LTM_TYPE": 0
              }
            },
            "K": {
              "type": "number",
              "description": "Adjustment Factor. Required when LTM_TYPE is User Input(1).",
              "default": 1,
              "x-ui": {
                "component": "NumberInput",
                "label": "K",
                "order": 7
              },
              "x-required-when": {
                "LTM_TYPE": 1
