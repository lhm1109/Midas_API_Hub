              "then": {
                "required": [
                  "K"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "STRAIN_I"
                      ]
                    },
                    {
                      "required": [
                        "STRAIN_J"
                      ]
                    },
                    {
                      "required": [
                        "KB"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "x-ui": {
        "label": "Assign"
