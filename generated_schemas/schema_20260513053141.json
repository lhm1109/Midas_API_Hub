                  "STRAIN_J",
                  "KB"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "STRAIN_I"
                      ]
                    },
                    {
                      "required": [
                        "K"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "LTM_TYPE",
                  "POSITION"
                ],
                "properties": {
                  "LTM_TYPE": {
                    "const": 0
                  },
                  "POSITION": {
                    "const": 2
                  }
                }
              },
              "then": {
                "required": [
                  "STRAIN_I",
                  "STRAIN_J",
                  "KB"
                ],
                "not": {
                  "required": [
                    "K"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "LTM_TYPE"
