              "then": {
                "required": [
                  "STRAIN_I",
                  "KB"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "STRAIN_J"
                      ]
                    },
                    {
                      "required": [
                        "K"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "LTM_TYPE",
                  "POSITION"
                ],
                "properties": {
                  "LTM_TYPE": {
                    "const": 0
                  },
                  "POSITION": {
                    "const": 1
                  }
                }
              },
              "then": {
