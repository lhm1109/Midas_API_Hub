{
  "type": "object",
  "required": [
    "Assign"
  ],
  "additionalProperties": false,
  "properties": {
    "Assign": {
      "type": "object",
      "description": "Keyed object (dictionary). Each property name is an ID string (e.g., \"1\").",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+$": {
          "title": "STYP",
          "type": "object",
          "description": "Structure type, mass control, gravity/temperature, and display alignment settings.",
          "additionalProperties": false,
          "properties": {
            "STYP": {
              "type": "integer",
              "description": "Structure Type",
              "oneOf": [
                {
                  "title": "3-D",
                  "const": 0
                },
                {
                  "title": "X-Z Plane",
                  "const": 1
                },
                {
                  "title": "Y-Z Plane",
                  "const": 2
                },
                {
                  "title": "X-Y Plane",
                  "const": 3
                },
                {
                  "title": "Constraint RZ",
                  "const": 4
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "groupId": "STRUCT_TYPE",
                "label": "Structure Type",
                "order": 1
              }
            },
            "MASS": {
              "type": "integer",
              "description": "Mass Type",
              "oneOf": [
                {
                  "title": "Lumped Mass",
                  "const": 1
                },
                {
                  "title": "Consistent Mass",
                  "const": 2
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "groupId": "MASS_CTRL",
                "label": "Mass Type",
                "order": 2
              }
            },
            "bMASSOFFSET": {
              "type": "boolean",
              "description": "Consider Off-diagonal Masses",
              "x-ui": {
                "component": "Checkbox",
                "groupId": "MASS_CTRL",
                "label": "Consider Off-diagonal Masses",
                "order": 3
              },
              "x-optional-when": {
                "MASS": 1
              }
            },
            "bROTRIGID": {
              "type": "boolean",
              "description": "Considering Rotational Rigid Body Mode for Modal Participation Factor",
              "x-ui": {
                "component": "Checkbox",
                "groupId": "MASS_CTRL",
                "label": "Considering Rotational Rigid Body Mode for Modal Participation Factor",
                "order": 4
              },
              "x-optional-when": {
                "bMASSOFFSET": false,
                "MASS": 1
              }
            },
            "bSELFWEIGHT": {
              "type": "boolean",
              "description": "Convert Self-weight into Masses",
              "x-ui": {
                "component": "Checkbox",
                "groupId": "MASS_CTRL",
                "label": "Convert Self-weight into Masses",
                "order": 5
              }
            },
            "SMASS": {
              "type": "integer",
              "description": "Structure Mass Type",
              "oneOf": [
                {
                  "title": "Convert to X, Y, Z",
                  "const": 1
                },
                {
                  "title": "Convert to X, Y",
                  "const": 2
                },
                {
                  "title": "Convert to Z",
                  "const": 3
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "groupId": "MASS_CTRL",
                "label": "Self-weight Direction",
                "order": 6
              },
              "x-required-when": {
                "bSELFWEIGHT": true
              },
              "x-optional-when": {
                "bSELFWEIGHT": true
              }
            },
            "GRAV": {
              "type": "number",
              "description": "Gravity",
              "x-ui": {
                "component": "Input",
                "groupId": "PARAMS",
                "hint": "Uses the current project acceleration unit.",
                "label": "Gravity Acceleration",
                "order": 7
              }
            },
            "TEMP": {
              "type": "number",
              "description": "Initial Temperature",
              "x-ui": {
                "component": "Input",
                "groupId": "PARAMS",
                "hint": "Uses the current project temperature unit.",
                "label": "Initial Temperature",
                "order": 8
              }
            },
            "bALIGNBEAM": {
              "type": "boolean",
              "description": "Align Top of Beam Section",
              "x-ui": {
                "component": "Checkbox",
                "groupId": "DISPLAY",
                "label": "Align Top of Beam Section with Center Line (X-Y Plane) for Display",
                "order": 9
              }
            },
            "bALIGNSLAB": {
              "type": "boolean",
              "description": "Align Top of Slab(Plate)",
              "x-ui": {
                "component": "Checkbox",
                "groupId": "DISPLAY",
                "label": "Align Top of Slab(Plate) Section with Center Line (X-Y Plane) for Display",
                "order": 10
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "bSELFWEIGHT"
                ],
                "properties": {
                  "bSELFWEIGHT": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "SMASS"
                ]
              }
            }
          ],
          "x-ui": {
            "groups": [
              {
                "title": "Structure Type",
                "id": "STRUCT_TYPE"
              },
              {
                "title": "Mass Control Parameter",
                "id": "MASS_CTRL"
              },
              {
                "title": "Parameters",
                "id": "PARAMS"
              },
              {
                "title": "Display Options",
                "id": "DISPLAY"
              }
            ]
          }
        }
      }
    }
  }
}
