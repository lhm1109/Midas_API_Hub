{
  "type": "object",
  "required": [
    "Assign"
  ],
  "additionalProperties": false,
  "properties": {
    "Assign": {
      "type": "object",
      "description": "Keyed object (dictionary). Each property name is an ID string (e.g., \"1\").",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+$": {
          "title": "STYP",
          "type": "object",
          "description": "Structure Type settings keyed by database ID.",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "STYP": {
              "type": "integer",
              "description": "Structure Type selection.",
              "oneOf": [
                {
                  "title": "3-D",
                  "const": 0
                },
                {
                  "title": "X-Z Plane",
                  "const": 1
                },
                {
                  "title": "Y-Z Plane",
                  "const": 2
                },
                {
                  "title": "X-Y Plane",
                  "const": 3
                },
                {
                  "title": "Constraint RZ",
                  "const": 4
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "groupId": "STRUCT_TYPE",
                "label": "Structure Type",
                "order": 1
              }
            },
            "MASS": {
              "type": "integer",
              "description": "Mass control type.",
              "oneOf": [
                {
                  "title": "Lumped Mass",
                  "const": 1
                },
                {
                  "title": "Consistent Mass",
                  "const": 2
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "groupId": "MASS_CTRL",
                "label": "Mass Type",
                "order": 2
              }
            },
            "bMASSOFFSET": {
              "type": "boolean",
              "description": "Consider off-diagonal masses.",
              "default": false,
              "x-ui": {
                "groupId": "MASS_CTRL",
                "label": "Consider Off-diagonal Masses",
                "order": 3
              },
              "x-optional-when": {
                "MASS": 1
              }
            },
            "bROTRIGID": {
              "type": "boolean",
              "description": "Consider rotational rigid body mode for modal participation factor.",
              "default": false,
              "x-ui": {
                "groupId": "MASS_CTRL",
                "hint": "UI enables this only when off-diagonal masses are not considered.",
                "label": "Considering Rotational Rigid Body Mode for Modal Participation Factor",
                "order": 4
              },
              "x-optional-when": {
                "MASS": 1
              }
            },
            "bSELFWEIGHT": {
              "type": "boolean",
              "description": "Convert self-weight into masses.",
              "default": false,
              "x-ui": {
                "groupId": "MASS_CTRL",
                "label": "Convert Self-weight into Masses",
                "order": 5
              }
            },
            "SMASS": {
              "type": "integer",
              "description": "Self-weight conversion direction.",
              "default": 1,
              "oneOf": [
                {
                  "title": "Convert to X, Y, Z",
                  "const": 1
                },
                {
                  "title": "Convert to X, Y",
                  "const": 2
                },
                {
                  "title": "Convert to Z",
                  "const": 3
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "groupId": "MASS_CTRL",
                "label": "Structure Mass Type",
                "order": 6
              },
              "x-optional-when": {
                "bSELFWEIGHT": true
              }
            },
            "GRAV": {
              "type": "number",
              "description": "Gravity acceleration.",
              "x-ui": {
                "groupId": "PARAMS",
                "label": "Gravity Acceleration",
                "order": 7
              }
            },
            "TEMP": {
              "type": "number",
              "description": "Initial temperature.",
              "default": 0,
              "x-ui": {
                "groupId": "PARAMS",
                "label": "Initial Temperature",
                "order": 8
              }
            },
            "bALIGNBEAM": {
              "type": "boolean",
              "description": "Align top of beam section with center line for display.",
              "default": false,
              "x-ui": {
                "groupId": "DISPLAY",
                "label": "Align Top of Beam Section with Center Line (X-Y Plane) for Display",
                "order": 9
              }
            },
            "bALIGNSLAB": {
              "type": "boolean",
              "description": "Align top of slab(plate) section with center line for display.",
              "default": false,
              "x-ui": {
                "groupId": "DISPLAY",
                "label": "Align Top of Slab(Plate) Section with Center Line (X-Y Plane) for Display",
                "order": 10
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "MASS",
                  "bSELFWEIGHT"
                ],
                "properties": {
                  "MASS": {
                    "const": 2
                  },
                  "bSELFWEIGHT": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "SMASS": {
                    "enum": [
                      1
                    ]
                  }
                }
              }
            }
          ],
          "x-ui": {
            "groups": [
              {
                "title": "Structure Type",
                "id": "STRUCT_TYPE"
              },
              {
                "title": "Mass Control Parameter",
                "id": "MASS_CTRL"
              },
              {
                "title": "Parameters",
                "id": "PARAMS"
              },
              {
                "title": "Display Options",
                "id": "DISPLAY"
              }
            ]
          }
        }
      }
    }
  }
}
