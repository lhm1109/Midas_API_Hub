{
  "type": "object",
  "required": [
    "Assign"
  ],
  "additionalProperties": false,
  "properties": {
    "Assign": {
      "type": "object",
      "description": "Keyed object (dictionary). Each property name is an ID string (e.g., \"1\").",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "required": [
            "DESIGN_CD"
          ],
          "additionalProperties": false,
          "properties": {
            "DESIGN_CD": {
              "type": "string",
              "description": "Concrete design code standard",
              "oneOf": [
                {
                  "title": "KDS 41 20 : 2022",
                  "const": "KDS 41 20 : 2022"
                }
              ],
              "x-ui": {
                "component": "ComboBox",
                "label": "Design Code",
                "order": 1
              }
            },
            "SEISMIC_PROV": {
              "type": "boolean",
              "description": "Apply Special Provisions for Seismic Design",
              "default": false,
              "x-ui": {
                "label": "Apply Special Provisions for Seismic Design",
                "order": 2
              }
            },
            "SEISMIC": {
              "type": "object",
              "description": "Seismic design parameters",
              "additionalProperties": false,
              "properties": {
                "FRAME_TYPE": {
                  "type": "string",
                  "description": "Select Frame Type",
                  "default": "Special",
                  "oneOf": [
                    {
                      "title": "Special Moment Frames",
                      "const": "Special"
                    },
                    {
                      "title": "Intermediate Moment Frames",
                      "const": "Intermediate"
                    },
                    {
                      "title": "Ordinary Moment Frames",
                      "const": "Ordinary"
                    }
                  ],
                  "x-ui": {
                    "component": "RadioGroup",
                    "label": "Select Frame Type",
                    "order": 1
                  }
                },
                "STRONG_COL_WEAK_LAST": {
                  "type": "boolean",
                  "description": "Consider strong column-weak beam on last floor",
                  "default": false,
                  "x-ui": {
                    "label": "Consider strong column-weak beam on last floor",
                    "order": 2
                  }
                },
                "SHEAR_WALL": {
                  "type": "object",
                  "description": "Shear Wall Type configuration",
                  "additionalProperties": false,
                  "properties": {
                    "SPEC_RC_WALL": {
                      "type": "boolean",
                      "description": "Special RC Structural Wall",
                      "default": false,
                      "x-ui": {
                        "component": "Switch",
                        "label": "Special RC Structural Wall",
                        "order": 1,
                        "depth": 2
                      }
                    },
                    "BDRY_ELEM_MTHD": {
                      "type": "string",
                      "description": "Boundary Element Method",
                      "default": "Displacement",
                      "oneOf": [
                        {
                          "title": "Displacement Based Method",
                          "const": "Displacement"
                        },
                        {
                          "title": "Stress Based Method",
                          "const": "Stress"
                        }
                      ],
                      "x-ui": {
                        "component": "RadioGroup",
                        "label": "Boundary Element Method",
                        "order": 2
                      },
                      "x-optional-when": {
                        "SPEC_RC_WALL": true
                      }
                    },
                    "DEFL_AMP_FACT": {
                      "type": "number",
                      "description": "Deflection Amplification Factor (Cd)",
                      "default": 4.5,
                      "minimum": 0,
                      "x-ui": {
                        "label": "Deflection Amplification Factor (Cd)",
                        "order": 3
                      },
                      "x-optional-when": {
                        "SPEC_RC_WALL": true
                      }
                    },
                    "IMP_FACT": {
                      "type": "number",
                      "description": "Important Factor (Ie)",
                      "default": 1.2,
                      "minimum": 0,
                      "x-ui": {
                        "label": "Important Factor (Ie)",
                        "order": 4
                      },
                      "x-optional-when": {
                        "SPEC_RC_WALL": true
                      }
                    }
                  },
                  "x-ui": {
                    "label": "Shear Wall Type",
                    "order": 3
                  },
                                        "x-optional-when": {
                        "SPEC_RC_WALL": true
                      }
                },
                "SHEAR_DES": {
                  "type": "object",
                  "description": "Shear for Design configuration",
                  "additionalProperties": false,
                  "properties": {
                    "MTHD": {
                      "type": "string",
                      "description": "Calculation method",
                      "default": "MIN",
                      "oneOf": [
                        {
                          "title": "MAX(Ve1,Ve2)",
                          "const": "MAX"
                        },
                        {
                          "title": "MIN(Ve1,Ve2)",
                          "const": "MIN"
                        },
                        {
                          "title": "Ve1",
                          "const": "Ve1"
                        },
                        {
                          "title": "Ve2",
                          "const": "Ve2"
                        }
                      ],
                      "x-ui": {
                        "component": "RadioGroup",
                        "label": "Method",
                        "order": 1
                      }
                    },
                    "A1": {
                      "type": "number",
                      "description": "Ve1 = Vg + a1*Σ(Mn)/L coefficient",
                      "default": 1,
                      "x-ui": {
                        "hint": "Ve1 = Vg + a1*Σ(Mn)/L",
                        "label": "a1",
                        "order": 2
                      }
                    },
                    "A2": {
                      "type": "number",
                      "description": "Ve2 = Vg + a2*Veq coefficient",
                      "default": 2,
                      "x-ui": {
                        "hint": "Ve2 = Vg + a2*Veq",
                        "label": "a2",
                        "order": 3
                      }
                    }
                  },
                  "x-ui": {
                    "label": "Shear for Design",
                    "order": 4
                  }
                },
                "BEAM_COL_JNT_DES": {
                  "type": "boolean",
                  "description": "Beam-Column Joint Design",
                  "default": false,
                  "x-ui": {
                    "label": "Beam-Column Joint Design",
                    "order": 5
                  }
                },
                "JOINT": {
                  "type": "object",
                  "description": "Beam-Column Joint configuration",
                  "additionalProperties": false,
                  "properties": {
                    "CHK_POS": {
                      "type": "string",
                      "description": "Select Check Position",
                      "default": "Top",
                      "oneOf": [
                        {
                          "title": "Top",
                          "const": "Top"
                        },
                        {
                          "title": "Bottom",
                          "const": "Bottom"
                        }
                      ],
                      "x-ui": {
                        "component": "RadioGroup",
                        "label": "Select Check Position",
                        "order": 1
                      }
                    },
                    "EXCL_MEM_TYPES": {
                      "type": "object",
                      "description": "Member Types to be excluded in Seismic Design",
                      "additionalProperties": false,
                      "properties": {
                        "SUB_BEAM": {
                          "type": "boolean",
                          "description": "Exclude Sub-Beam",
                          "default": false,
                          "x-ui": {
                            "label": "Sub-Beam",
                            "order": 1
                          }
                        },
                        "CANTILEVER": {
                          "type": "boolean",
                          "description": "Exclude Cantilever",
                          "default": false,
                          "x-ui": {
                            "label": "Cantilever",
                            "order": 2
                          }
                        },
                        "UG_BEAM_COL": {
                          "type": "boolean",
                          "description": "Exclude Underground Beam/Column",
                          "default": false,
                          "x-ui": {
                            "label": "Underground Beam/Column",
                            "order": 3
                          }
                        }
                      },
                      "x-ui": {
                        "label": "Member Types to be excluded in Seismic Design",
                        "order": 2
                      }
                    }
                  },
                  "x-ui": {
                    "order": 6
                  },
                  "x-optional-when": {
                    "BEAM_COL_JNT_DES": true
                  }
                }
              },
              "x-ui": {
                "label": "Seismic Design Parameter",
                "order": 3
              },
              "x-optional-when": {
                "SEISMIC_PROV": true
              }
            },
            "TORS_DES": {
              "type": "boolean",
              "description": "Torsion Design",
              "default": false,
              "x-ui": {
                "label": "Torsion Design",
                "order": 4
              }
            },
            "TORS_RDCT_FACT": {
              "type": "number",
              "description": "Torsion Reduction Factor for Beam",
              "default": 1,
              "minimum": 0,
              "x-ui": {
                "label": "Torsion Reduction Factor for Beam",
                "order": 5
              },
              "x-optional-when": {
                "TORS_DES": true
              }
            },
            "MOM_REDIST_FACT": {
              "type": "number",
              "description": "Moment Redistribution Factor for Beam",
              "default": 1,
              "minimum": 0,
              "maximum": 1,
              "x-ui": {
                "label": "Moment Redistribution Factor for Beam",
                "order": 6
              }
            },
            "MOM_CALC_MTHD": {
              "type": "string",
              "description": "Moment Calculation Method for Beam",
              "default": "Equivalent",
              "oneOf": [
                {
                  "title": "Equivalent Rebar",
                  "const": "Equivalent"
                },
                {
                  "title": "Each Rebar",
                  "const": "Each"
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "Moment Calculation Method for Beam",
                "order": 7
              }
            },
            "USE_SUBDIV_FORCE": {
              "type": "boolean",
              "description": "Use Subdivided Force for Beam Assigned as Member",
              "default": false,
              "x-ui": {
                "label": "Use Subdivided Force for Beam Assigned as Member",
                "order": 8
              }
            },
            "EXP_COND": {
              "type": "string",
              "description": "Exposure Condition (kcr)",
              "default": "Dry",
              "oneOf": [
                {
                  "title": "Dry",
                  "const": "Dry"
                },
                {
                  "title": "etc",
                  "const": "etc"
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "Exposure Condition (kcr)",
                "order": 9
              }
            },
            "PM_CRV_CALC": {
              "type": "string",
              "description": "P-M Curve Calculation Method",
              "default": "KeepMPConstant",
              "oneOf": [
                {
                  "title": "Keep P Constant",
                  "const": "KeepPConstant"
                },
                {
                  "title": "Keep M/P Constant",
                  "const": "KeepMPConstant"
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "P-M Curve Calculation Method",
                "order": 10
              }
            },
            "UG_LC": {
              "type": "boolean",
              "description": "Use Under Ground Load Combination Type for Under Ground Members",
              "default": true,
              "x-ui": {
                "label": "Use Under Ground Load Combination Type for Under Ground Members",
                "order": 11
              }
            },
            "CONC_STRS_STRN": {
              "type": "string",
              "description": "Concrete Stress-Strain Type for Bending",
              "default": "Equivalent",
              "oneOf": [
                {
                  "title": "Equivalent-Rectangle",
                  "const": "Equivalent"
                },
                {
                  "title": "Parabola-Rectangle (Average)",
                  "const": "Parabola"
                }
              ],
              "x-ui": {
                "component": "ComboBox",
                "label": "Concrete Stress-Strain Type for Bending",
                "order": 12
              }
            },
            "FS_MAIN_BAR": {
              "type": "string",
              "description": "fs of Main bar in Beam Design",
              "default": "2/3*fy",
              "oneOf": [
                {
                  "title": "2/3*fy",
                  "const": "2/3fy"
                },
                {
                  "title": "By Program",
                  "const": "ByProgram"
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "fs of Main bar in Beam Design",
                "order": 13
              }
            }
          }
        }
      }
    }
  }
}