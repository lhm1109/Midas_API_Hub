{
  "type": "object",
  "required": [
    "Argument"
  ],
  "additionalProperties": false,
  "properties": {
    "Argument": {
      "type": "object",
      "required": [
        "CURRENT_MODE",
        "WALL_LIST",
        "EXPORT_PATH",
        "OUTPUT_NAME"
      ],
      "additionalProperties": false,
      "properties": {
        "CURRENT_MODE": {
          "type": "string",
          "description": "Report output mode",
          "oneOf": [
            {
              "title": "Graphic (JPG image)",
              "const": "Graphic"
            },
            {
              "title": "Detail (DOC document)",
              "const": "Detail"
            },
            {
              "title": "Summary (TXT text)",
              "const": "Summary"
            },
            {
              "title": "PM Curve (JPG image)",
              "const": "PMCurve"
            }
          ],
          "x-ui": {
            "component": "RadioGroup",
            "label": "Report Mode",
            "order": 1
          }
        },
        "WALL_LIST": {
          "type": "array",
          "description": "List of walls to include in the report (WID, Story, and Wall Mark required for identification)",
          "items": {
            "type": "object",
            "required": [
              "WID",
              "STORY",
              "WALL_MARK"
            ],
            "properties": {
              "WID": {
                "type": "integer",
                "description": "Wall ID number"
              },
              "STORY": {
                "type": "string",
                "description": "Story name"
              },
              "WALL_MARK": {
                "type": "string",
                "description": "Wall Mark designation"
              }
            }
          },
          "x-ui": {
            "label": "Wall List",
            "order": 2
          }
        },
        "EXPORT_PATH": {
          "type": "string",
          "description": "Directory path to save the report files",
          "x-ui": {
            "hint": "e.g. C:\\MIDAS\\Report\\",
            "label": "Export Path",
            "order": 3
          }
        },
        "OUTPUT_NAME": {
          "type": "string",
          "description": "Output file base name. For multiple walls, files are prefixed with index and wall identifier (e.g. 001_W100_1F_filename.jpg, 002_W200_2F_filename.jpg)",
          "x-ui": {
            "label": "Output File Name",
            "order": 4
          }
        }
      }
    }
  }
}
