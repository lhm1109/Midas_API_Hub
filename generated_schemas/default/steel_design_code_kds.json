{
  "type": "object",
  "required": [
    "Assign"
  ],
  "additionalProperties": false,
  "properties": {
    "Assign": {
      "type": "object",
      "description": "Keyed object (dictionary). Each property name is an ID string (e.g., \"1\").",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+$": {
          "title": "Steel Design Code",
          "type": "object",
          "required": [
            "DESIGN_CD"
          ],
          "additionalProperties": false,
          "properties": {
            "DESIGN_CD": {
              "type": "string",
              "description": "Design Code",
              "enum": [
                "KDS 41 30 : 2022"
              ],
              "x-ui": {
                "component": "Dropdown",
                "label": "Design Code",
                "order": 1
              }
            },
            "LAT_BRACE": {
              "type": "boolean",
              "description": "All Beams/Girders are Laterally Braced",
              "default": false,
              "x-ui": {
                "label": "All Beams/Girders are Laterally Braced",
                "order": 2
              }
            },
            "DEFL_CHK": {
              "type": "boolean",
              "description": "Check Beam/Column Deflection",
              "default": true,
              "x-ui": {
                "label": "Check Beam/Column Deflection",
                "order": 3
              }
            },
            "SEISMIC": {
              "type": "boolean",
              "description": "Apply Special Provisions for Seismic Design",
              "default": false,
              "x-ui": {
                "label": "Apply Special Provisions for Seismic Design",
                "order": 4
              }
            },
            "COMB_RATIO": {
              "type": "integer",
              "description": "Combined Ratio Method for Circular Section",
              "default": 0,
              "oneOf": [
                {
                  "title": "SRSS (Square root of sum of square)",
                  "const": 0
                },
                {
                  "title": "Linear Sum",
                  "const": 1
                }
              ],
              "x-ui": {
                "component": "RadioGroup",
                "label": "Combined Ratio Method for Circular Section",
                "order": 5
              }
            },
            "SEIS_SYS": {
              "type": "string",
              "description": "Seismic Load Resisting System",
              "enum": [
                "Special Moment Frames",
                "Intermediate Moment Frames",
                "Ordinary Moment Frames",
                "Special Concentrically Braced Frames",
                "Ordinary Concentrically Braced Frames",
                "Eccentrically Braced Frames",
                "Buckling Restrained Braced Frames",
                "Special Plate Shear Walls"
              ],
              "default": "Special Moment Frames",
              "x-ui": {
                "component": "Dropdown",
                "group": "Seismic Load Resisting System",
                "label": "System",
                "order": 6
              },
              "x-optional-when": {
                "SEISMIC": true
              }
            },
            "COL_WEAK": {
              "type": "boolean",
              "description": "Consider strong column-weak beam on last floor",
              "default": true,
              "x-ui": {
                "group": "Seismic Load Resisting System",
                "label": "Consider strong column-weak beam on last floor",
                "order": 7
              },
              "x-optional-when": {
                "SEISMIC": true
              }
            },
            "UNDGR_LD": {
              "type": "boolean",
              "description": "Use Under Ground Load Combination Type for Under Ground Members",
              "default": true,
              "x-ui": {
                "label": "Use Under Ground Load Combination Type for Under Ground Members",
                "order": 8
              }
            }
          }
        }
      }
    }
  }
}
