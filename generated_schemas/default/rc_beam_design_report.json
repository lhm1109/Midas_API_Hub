{
  "type": "object",
  "required": [
    "Argument"
  ],
  "additionalProperties": false,
  "properties": {
    "Argument": {
      "type": "object",
      "required": [
        "REPORT_TYPE",
        "EXPORT_PATH",
        "OUTPUT_NAME"
      ],
      "additionalProperties": false,
      "properties": {
        "REPORT_TYPE": {
          "type": "string",
          "description": "Report Table Type",
          "enum": [
            "MEMB",
            "PROP"
          ],
          "x-ui": {
            "label": "Table Type",
            "order": 1
          }
        },
        "CURRENT_MODE_MEMB": {
          "type": "string",
          "description": "Report output mode for element-based report",
          "oneOf": [
            {
              "title": "Graphic (JPG image)",
              "const": "Graphic"
            },
            {
              "title": "Detail (DOC document)",
              "const": "Detail"
            },
            {
              "title": "Summary (TXT text)",
              "const": "Summary"
            }
          ],
          "x-ui": {
            "component": "RadioGroup",
            "label": "Report Mode",
            "order": 2
          },
          "x-optional-when": {
            "REPORT_TYPE": "MEMB"
          }
        },
        "CURRENT_MODE_PROP": {
          "type": "string",
          "description": "Report output mode for property-based report",
          "oneOf": [
            {
              "title": "Graphic (JPG image)",
              "const": "Graphic"
            },
            {
              "title": "Summary (TXT text)",
              "const": "Summary"
            }
          ],
          "x-ui": {
            "component": "RadioGroup",
            "label": "Report Mode",
            "order": 2
          },
          "x-optional-when": {
            "REPORT_TYPE": "PROP"
          }
        },
        "ELEMS": {
          "type": "object",
          "description": "Element No. Input. Optional when REPORT_TYPE is MEMB.",
          "additionalProperties": false,
          "properties": {
            "KEYS": {
              "type": "array",
              "description": "Specify Each ID",
              "items": {
                "type": "integer"
              },
              "x-ui": {
                "label": "Specify Each ID",
                "order": 1
              }
            },
            "TO": {
              "type": "string",
              "description": "Specify ID Range (e.g., '1to160')",
              "x-ui": {
                "label": "Specify ID Range",
                "placeholder": "e.g. 1to160",
                "order": 2
              }
            },
            "STRUCTURE_GROUP_NAME": {
              "type": "string",
              "description": "Specify Structure Group Name",
              "x-ui": {
                "label": "Structure Group Name",
                "order": 3
              }
            }
          },
          "x-ui": {
            "label": "Element Numbers",
            "order": 3
          },
          "x-optional-when": {
            "REPORT_TYPE": "MEMB"
          }
        },
        "SECTIONS": {
          "type": "array",
          "description": "List of section numbers to include in the report. Optional when REPORT_TYPE is PROP.",
          "items": {
            "type": "integer"
          },
          "x-ui": {
            "label": "Section Numbers",
            "order": 3
          },
          "x-optional-when": {
            "REPORT_TYPE": "PROP"
          }
        },
        "DETAIL_POSITIONS": {
          "type": "object",
          "description": "Print positions for Detail report",
          "properties": {
            "END_I": {
              "type": "boolean",
              "description": "Include End I position",
              "default": true
            },
            "MID": {
              "type": "boolean",
              "description": "Include Mid position",
              "default": false
            },
            "END_J": {
              "type": "boolean",
              "description": "Include End J position",
              "default": false
            }
          },
          "x-ui": {
            "label": "Option for Detail Print Position",
            "order": 4
          },
          "x-optional-when": {
            "REPORT_TYPE": "MEMB",
            "CURRENT_MODE_MEMB": "Detail"
          }
        },
        "EXPORT_PATH": {
          "type": "string",
          "description": "Directory path to save the report files",
          "x-ui": {
            "hint": "e.g. C:\\MIDAS\\Report\\",
            "label": "Export Path",
            "order": 5
          }
        },
        "OUTPUT_NAME": {
          "type": "string",
          "description": "Output file base name. For multiple elements, files are prefixed with index and element number (e.g. 001_E859_filename.jpg, 002_E1_filename.jpg)",
          "x-ui": {
            "label": "Output File Name",
            "order": 6
          }
        }
      }
    }
  }
}