    PUSHBUTTON      "Close",IDCANCEL,233,226,52,18
    LTEXT           "Nonlinear Modal and Nonlinear Static analysis options in the time history analysis.",IDC_CMD_NLLINK_PRT_DESC_FORCE_STC2,9,36,272,12,SS_CENTERIMAGE
    LTEXT           "¡¤ Effective Stiffness of Force Type does not affect the time history analysis results",IDC_CMD_NLLINK_PRT_DESC_FORCE_STC3,5,52,272,12,SS_CENTERIMAGE
    LTEXT           "with Nonlinear Direct Integration, Nonlinear Modal and Nonlinear Static analysis ",IDC_CMD_NLLINK_PRT_DESC_FORCE_STC4,9,66,272,12,SS_CENTERIMAGE
    LTEXT           "options. It is used for the calculation of convergence. ",IDC_CMD_NLLINK_PRT_DESC_FORCE_STC5,9,80,272,12,SS_CENTERIMAGE
    GROUPBOX        "Element Type 2 : Seismic Control Devices",IDC_CMD_NLLINK_PRT_DESC_ELEM2_GRP,0,107,285,109
    LTEXT           "¡¤ Seismic Control Devices are only applied to Nonlinear Direct Integration, Nonlinear",IDC_CMD_NLLINK_PRT_DESC_ELEM2_STC1,5,123,275,12,SS_CENTERIMAGE
    LTEXT           "Static analysis options in the time history analysis. The devices are considered as ",IDC_CMD_NLLINK_PRT_DESC_ELEM2_STC2,9,137,272,12,SS_CENTERIMAGE
    LTEXT           "¡¤ Effective Stiffness of Seismic Control Devices is not used for the time history ",IDC_CMD_NLLINK_PRT_DESC_ELEM2_STC4,5,169,272,12,SS_CENTERIMAGE
    LTEXT           "analysis results with Nonlinear Direct Integration and Nonlinear Static analysis",IDC_CMD_NLLINK_PRT_DESC_ELEM2_STC5,9,183,272,12,SS_CENTERIMAGE
    LTEXT           "options. Otherwise, it is considered as linear spring.",IDC_CMD_NLLINK_PRT_DESC_ELEM2_STC6,9,197,272,12,SS_CENTERIMAGE
    LTEXT           "linear springs for the Nonlinear Modal analysis option.",IDC_CMD_NLLINK_PRT_DESC_ELEM2_STC3,9,151,272,12,SS_CENTERIMAGE
END

