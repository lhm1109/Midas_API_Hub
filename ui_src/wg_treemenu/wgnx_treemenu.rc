    IDD_TM_DESIGN_STRIP_MODIFY_SECTION, DIALOG
    BEGIN
        LEFTMARGIN, 3
        RIGHTMARGIN, 122
        TOPMARGIN, 7
        BOTTOMMARGIN, 310
    END
END
#endif    // APSTUDIO_INVOKED


