{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STRPSSM API Schema",
  "type": "object",
  "description": "Stress point settings for section manager (DB/STRPSSM).",
  "required": [
    "Assign"
  ],
  "additionalProperties": false,
  "properties": {
    "Assign": {
      "type": "object",
      "description": "Map of stress point IDs.",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "required": [
            "POINT_SIZE_1",
            "POINT_SIZE_2",
            "POINT1",
            "POINT2"
          ],
          "additionalProperties": false,
          "properties": {
            "OPT_SAME_J": {
              "description": "Same Additional Stress Points Data at i & j-end",
              "type": "boolean",
              "default": true
            },
            "POINT_SIZE_1": {
              "description": "Point Size 1",
              "type": "integer"
            },
            "POINT_SIZE_2": {
              "description": "Point Size 2",
              "type": "integer"
            },
            "POINT1": {
              "description": "PointData1",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "PY",
                  "PZ"
                ],
                "additionalProperties": false,
                "properties": {
                  "PY": {
                    "description": "PointY",
                    "type": "number"
                  },
                  "PZ": {
                    "description": "PointZ",
                    "type": "number"
                  }
                }
              }
            },
            "POINT2": {
              "description": "PointData2",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "PY",
                  "PZ"
                ],
                "additionalProperties": false,
                "properties": {
                  "PY": {
                    "description": "PointY",
                    "type": "number"
                  },
                  "PZ": {
                    "description": "PointZ",
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    }
  }
}
